{
  "info": {
    "name": "Messaging App API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login (JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/token/",
          "host": ["{{base_url}}"],
          "path": ["api", "token", ""]
        }
      }
    },
    {
      "name": "Auth - Access Private Conversation (Unauthorized)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/chats/conversations/",
          "host": ["{{base_url}}"],
          "path": ["chats", "conversations", ""]
        }
      }
    },
    {
      "name": "Create Conversation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participants\": [1, 2]\n}"
        },
        "url": {
          "raw": "{{base_url}}/chats/conversations/",
          "host": ["{{base_url}}"],
          "path": ["chats", "conversations", ""]
        }
      }
    },
    {
      "name": "Send Message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation\": 1,\n  \"sender\": 1,\n  \"content\": \"Hello from Postman!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/chats/messages/",
          "host": ["{{base_url}}"],
          "path": ["chats", "messages", ""]
        }
      }
    },
    {
      "name": "Get My Conversations",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/chats/conversations/",
          "host": ["{{base_url}}"],
          "path": ["chats", "conversations", ""]
        }
      }
    },
    {
      "name": "Get Messages in Conversation",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/chats/messages/?conversation=1",
          "host": ["{{base_url}}"],
          "path": ["chats", "messages", ""],
          "query": [
            { "key": "conversation", "value": "1" }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ]
}
